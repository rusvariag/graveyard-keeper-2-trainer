<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-game helper. Target .NET Framework 4.7.2: the profile Unity's Mono runtime runs. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GK2Spawner</AssemblyName>
    <RootNamespace>GK2Spawner</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Path to the game's managed assemblies (override with -p:GameManaged=...). -->
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildProjectDirectory)/../../GraveyardKeeper2_Data/Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(GameManaged)/LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(GameManaged)/Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
